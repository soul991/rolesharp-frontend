# RoleSharp 2.0 — Environment Configuration Example
# Copy to .env.local for local overrides. Never commit secrets.

# Backend API Origin (Relative path / proxy recommended in development)
VITE_API_BASE_URL=/api

# Feature Flags
VITE_FEATURE_VOICE_INTERVIEW=false
VITE_FEATURE_AUTO_APPLY=true

# Application Environment
VITE_APP_ENV=development
